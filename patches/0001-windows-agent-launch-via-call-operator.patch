# herdr: launch agents with the call operator, not Start-Process
#
# PRD-DELTA #13a.2. Found while launching Claude Code and Codex from Osade on Windows.
#
# WHAT HAPPENS
#   `agent.start` on Windows builds a PowerShell script that runs the agent through
#   `Start-Process -FilePath <program> -ArgumentList '<args>'` unless `Get-Command` reports the
#   program as an `ExternalScript`. Node-installed agents are neither: `claude` on PATH is
#   `claude.cmd` (CommandType `Application`), so it takes the Start-Process branch and dies with
#
#       %1 is not a valid Win32 application
#
#   `Start-Process -FilePath` wants an executable image. A `.cmd` shim is not one.
#
# WHY THIS FIX
#   PowerShell's call operator runs whatever `Get-Command` resolved, whether that is an .exe, a
#   .cmd, a .bat or a .ps1 — including the ExternalScript case the branch already handled, which
#   is why the branch can go away entirely rather than gain a third arm. `&` is also synchronous
#   in the current console, so `-NoNewWindow -Wait` was already describing what `&` does.
#
#   `quote_windows_command_line_arg` stays: it has another caller at windows.rs:913.
#
# NOT COMPILED HERE
#   herdr requires Zig 0.15.2 for libghostty-vt and this machine has no Zig, so this was verified
#   by reading and by `git apply --check`, not by `cargo test`. The one test that pins the old
#   string is updated in the same patch; a maintainer should run
#   `cargo test -p herdr platform::windows` before taking it.
#
# WORKAROUND IN OSADE MEANWHILE
#   `agentStartArgsSupported()` returns false on Windows, so Osade starts agents bare and
#   delivers context through `.osade/CONTEXT.md`. That loses mode flags such as
#   `--permission-mode`, which is a real capability reduction and is reported to the user rather
#   than hidden.
--- a/src/platform/windows.rs
+++ b/src/platform/windows.rs
@@ -562,18 +562,15 @@
         .map(|arg| super::quote_powershell_arg(arg))
         .collect::<Vec<_>>()
         .join(" ");
-    let command_line = args
-        .iter()
-        .map(|arg| quote_windows_command_line_arg(arg))
-        .collect::<Vec<_>>()
-        .join(" ");
+    // The call operator runs whatever `Get-Command` resolves - .exe, .cmd, .bat and .ps1 alike.
+    // `Start-Process -FilePath` needs an *executable*, so an npm shim (`claude.ps1`, `claude.cmd`,
+    // `codex.cmd` on PATH) fails with "%1 is not a valid Win32 application". The call operator
+    // already covers the ExternalScript case the branch was guarding, so there is nothing left
+    // for `Start-Process` to do.
     Some(format!(
-        "if((Get-Command {} -ErrorAction SilentlyContinue).CommandType -eq 'ExternalScript'){{& {} {}}}else{{Start-Process -FilePath {} -ArgumentList {} -NoNewWindow -Wait}}",
-        super::quote_powershell_arg(program),
+        "& {} {}",
         super::quote_powershell_arg(program),
         powershell_args,
-        super::quote_powershell_arg(program),
-        super::quote_powershell_arg(&command_line),
     ))
 }
 
@@ -2718,7 +2715,7 @@
             .collect::<Vec<_>>();
         assert_eq!(
             String::from_utf16(&utf16).unwrap(),
-            "if((Get-Command pi -ErrorAction SilentlyContinue).CommandType -eq 'ExternalScript'){& pi '' 'two words' '100%' 'wow!' 'a''b' '--model'}else{Start-Process -FilePath pi -ArgumentList '\"\" \"two words\" 100% wow! a''b --model' -NoNewWindow -Wait}"
+            "& pi '' 'two words' '100%' 'wow!' 'a''b' '--model'"
         );
     }
 
